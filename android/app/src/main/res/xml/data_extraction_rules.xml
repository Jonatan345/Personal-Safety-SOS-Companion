<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Emergency contacts and location history must never leave the device via backup/transfer. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
